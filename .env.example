# Unset means production (fail closed): use development or test locally.
ENVIRONMENT=development
# Must be a replica set (MongoDB Atlas always is); a local mongod needs --replSet rs0 and rs.initiate().
MONGODB_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=agentmesh
SECRET_KEY=change-me-to-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Accepts a JSON array or comma-separated origins, e.g. https://app.example.com,https://admin.example.com.
CORS_ORIGINS=["http://localhost:3000"]
LOG_JSON=false

PAYSTACK_SECRET_KEY=

# Platform commission on compute charges (providers get the rest). New price versions get the default unless
# the operator sets a rate; no version may exceed the maximum.
DEFAULT_PLATFORM_FEE_RATE=0.10
MAX_PLATFORM_FEE_RATE=0.50
METRICS_TOKEN=

COORDINATION_BACKEND=memory
# Use a password-protected Redis (redis://:<password>@host:6379/0); replicas trust its messages.
REDIS_URL=redis://localhost:6379/0
# docker-compose.yml only: password for its Redis container.
REDIS_PASSWORD=

# Proxy addresses (IPs or CIDRs) whose X-Forwarded-For uvicorn trusts for client IPs (rate limits, audit,
# webhook IP checks). Read by uvicorn itself. Never '*' when the API port is reachable without the proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# AI deployment agent (docs: /docs/ai-agent). Empty AI_INFERENCE_TOKEN disables it; generate with
# `openssl rand -hex 32` and give the same value to the inference machine's adapter.
AI_INFERENCE_TOKEN=
OLLAMA_MODEL=gemma4:e2b-it-qat
AI_REQUEST_TIMEOUT=180
AI_MAX_CONCURRENT_REQUESTS=1
AI_QUEUE_MAX_LENGTH=20
AI_QUEUE_TTL_SECONDS=3600

# Community models: customers import public GGUF files from Hugging Face, private to them; only nodes whose
# provider opted in serve them (docs: /docs/customers#huggingface).
COMMUNITY_MODELS_ENABLED=true
COMMUNITY_MODEL_MAX_BYTES=17179869184
COMMUNITY_MODELS_PER_CUSTOMER=20
COMMUNITY_MODEL_IMPORTS_PER_MINUTE=5
