# Database
DATABASE_URL=postgresql+asyncpg://agentmesh:agentmesh@localhost:5432/agentmesh
POSTGRES_DB=agentmesh
POSTGRES_USER=agentmesh
POSTGRES_PASSWORD=agentmesh

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
# Required outside dev/test: a random value of at least 32 characters, e.g. `openssl rand -hex 32`.
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Billing and payments (Paystack). Prices themselves are set by operators: POST /api/v1/admin/pricing.
BILLING_CURRENCY=NGN
BILLING_INTERVAL_SECONDS=300
BILLING_MIN_PREPAID_HOURS=1
# Paystack secret key. Test keys (sk_test_...) only, unless PAYSTACK_ALLOW_LIVE=true. Empty disables payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_ALLOW_LIVE=false
# Optional: Paystack's webhook source IPs as a JSON list (see Paystack docs). Leave empty behind proxies that hide them.
PAYSTACK_WEBHOOK_IPS=[]
# Dashboard URL; Paystack returns customers to $FRONTEND_URL/customer/wallet after checkout.
FRONTEND_URL=http://localhost:3000
TOPUP_MIN_AMOUNT=100
TOPUP_MAX_AMOUNT=1000000
PAYOUT_MIN_AMOUNT=1000
PAYOUTS_REQUIRE_APPROVAL=true
RECONCILE_AFTER_MINUTES=30

# Login/registration attempts per minute, per client address and per email
AUTH_RATE_LIMIT_PER_MINUTE=10

# Bearer token for GET /metrics (Prometheus). Empty disables the endpoint.
METRICS_TOKEN=

# Public URL customers use to reach the gateway (deployment endpoints are built from it). Must be https outside dev.
PUBLIC_BASE_URL=http://localhost:8000

# Worker protocol and lifecycle (defaults shown)
HEARTBEAT_TIMEOUT_SECONDS=90
ENROLLMENT_TOKEN_TTL_MINUTES=60
PROVISION_STALL_TIMEOUT_SECONDS=900
STOP_TIMEOUT_SECONDS=300

# Workers heartbeat at WORKER_HEARTBEAT_INTERVAL_SECONDS; HEARTBEAT_TIMEOUT_SECONDS must be at least 3x that.
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
# A deployment unhealthy this long moves to another node; each deployment is placed at most this many times.
UNHEALTHY_GRACE_SECONDS=180
MAX_SCHEDULE_ATTEMPTS=3

# "memory" for a single API process; "redis" to run several API replicas (shared limits and tunnel routing)
COORDINATION_BACKEND=memory

# JSON log lines with request ids (set false for plain text in local development)
LOG_JSON=true

# Inference gateway limits
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_MAX_CONCURRENT_PER_DEPLOYMENT=4

# Directory with signed worker releases (manifest.json, manifest.sig, wheel); see scripts/sign_worker_release.py
WORKER_RELEASE_DIR=

# Workers are configured separately with AGENTMESH_* variables; see docs/WORKER.md

# Frontend (NEXT_PUBLIC_* values are baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BILLING_CURRENCY=NGN

# Environment (dev/development/test enable developer conveniences; anything else is treated as production)
ENVIRONMENT=development
# JSON list of allowed browser origins. Wildcards are rejected outside dev/test.
CORS_ORIGINS=["http://localhost:3000"]
# Unpaid wallet "test credits" for local development. Ignored outside dev/test.
ALLOW_TEST_CREDITS=true
LOG_LEVEL=INFO
