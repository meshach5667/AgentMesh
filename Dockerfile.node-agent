# AgentMesh Docker worker. Manages Ollama workload containers through the host Docker daemon.
# The worker itself runs as an unprivileged user with a read-only root filesystem; it needs the Docker
# socket, which is root-equivalent on the host (see docs/security/PERMISSIONS.md). Workload containers never receive it.
# Base image pinned by digest (python:3.12-slim, resolved 26 October 2026); Dependabot proposes updates.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    AGENTMESH_MODE=docker \
    AGENTMESH_DATA_DIR=/var/lib/agentmesh

WORKDIR /opt/agentmesh
COPY server/requirements-worker-lock.txt .
RUN pip install --no-cache-dir --only-binary=:all: -r requirements-worker-lock.txt

COPY server/node_agent ./node_agent

RUN useradd --system --uid 10001 --home-dir /var/lib/agentmesh agentmesh \
    && mkdir -p /var/lib/agentmesh && chown agentmesh /var/lib/agentmesh && chmod 700 /var/lib/agentmesh
USER agentmesh
VOLUME ["/var/lib/agentmesh"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD ["python", "-m", "node_agent", "status", "--check"]

ENTRYPOINT ["python", "-m", "node_agent"]
CMD ["start"]
